---
import Base from "./Base.astro"

interface Props {
  title: string
  description: string
  effective: string
}

const { title, description, effective } = Astro.props
---

<Base title={`${title} | Message to PDF`} description={description}>
  <main class="px-6 py-16 md:px-10">
    <article
      class="mx-auto max-w-[46rem] space-y-5 text-[#f5f3ef]/80 text-sm leading-relaxed [&_a]:text-[#f5f3ef] [&_a]:underline [&_a]:underline-offset-2 [&_a:hover]:text-[#cba980] [&_h2]:pt-6 [&_h2]:font-[620] [&_h2]:text-[#f5f3ef] [&_h2]:text-lg"
    >
      <div class="space-y-2">
        <h1
          class="font-[680] text-[#f5f3ef] text-[clamp(1.9rem,4vw,2.4rem)] tracking-[-0.03em]"
        >
          {title}
        </h1>
        <p class="text-[#f5f3ef]/65 text-xs">Effective {effective}</p>
      </div>
      <slot />
      <p class="pt-8 text-[#f5f3ef]/65 text-xs">
        <a class="underline underline-offset-2 transition-colors hover:text-[#f5f3ef]" href="/">
          Back to Message to PDF
        </a>
      </p>
    </article>
  </main>
</Base>
