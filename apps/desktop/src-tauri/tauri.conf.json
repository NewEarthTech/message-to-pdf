{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Sheaf",
  "version": "1.0.0",
  "identifier": "com.sheaf.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:47611",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Sheaf",
        "width": 1000,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: John Carmack (T3UN6N5K6Z)",
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.15"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
