# Paddle config for the pricing page and checkout. Copy this to `.env.local`
# (git-ignored) for local dev. CI injects these in the deploy workflow.
#
# Nothing is silently defaulted: vite.config.ts fails the build (and dev
# startup) if the env/token pair is missing or mismatched, so you never run or
# ship against the wrong Paddle account.

# "sandbox" or "production". Local dev defaults to sandbox: test cards only,
# no real charges.
VITE_PADDLE_ENV=sandbox

# Client-side token (public-safe: Paddle designs it to ship in frontend JS).
# MUST match the env, sandbox tokens are prefixed `test_`, live tokens `live_`.
# From Paddle > Developer tools > Authentication.
VITE_PADDLE_CLIENT_TOKEN=test_xxxxxxxxxxxxxxxxxxxxxxxxxx

# The entitlement-gated download endpoint. /success links here with ?_ptxn=<txn>;
# that endpoint verifies the Paddle transaction and redirects to a short-lived
# signed CloudFront URL. Unset renders a "not wired yet" notice instead of a
# broken link.
VITE_DOWNLOAD_ENDPOINT=https://downloads.newearth.llc/
