---
import { guidesExcept } from "@/data/guides"
import Base from "@/layouts/Base.astro"
import { breadcrumbs, faqPage, guidePage, type QuestionAnswer } from "@/lib/schema"

interface Props {
  /** Route, extensionless. Drives the canonical, the breadcrumb and the
   * "related" list, so it is stated once here and nowhere else on the page. */
  path: string
  /** <title> without the brand suffix, which is appended. */
  title: string
  description: string
  h1: string
  /** Short label for the breadcrumb trail. */
  crumb: string
  /** The questions rendered at the foot of the page, and the FAQPage data. One
   * definition so the structured data can never describe answers that are not
   * on the page. */
  faqs: QuestionAnswer[]
}

const { path, title, description, h1, crumb, faqs } = Astro.props

// Long-form reading measure, matched to the FAQ and legal pages. The prose
// styling is applied by descendant selector so the pages themselves stay plain
// HTML and no class list has to be repeated per paragraph.
const prose = [
  "mt-10 space-y-5 text-[#f5f3ef]/75 leading-[1.7]",
  "[&_h2]:pt-8 [&_h2]:font-[640] [&_h2]:text-[#f5f3ef] [&_h2]:text-[clamp(1.3rem,2.4vw,1.6rem)] [&_h2]:tracking-[-0.02em]",
  "[&_h3]:pt-4 [&_h3]:font-[620] [&_h3]:text-[#cba980] [&_h3]:text-[1.02rem]",
  "[&_ul]:list-disc [&_ul]:space-y-2.5 [&_ul]:pl-5 [&_ul]:marker:text-[#93735a]",
  "[&_strong]:font-[600] [&_strong]:text-[#f5f3ef]",
  "[&_a]:border-b [&_a]:border-[#93735a]/45 [&_a]:pb-px [&_a]:text-[#cba980] [&_a:hover]:border-[#cba980]"
].join(" ")

const related = guidesExcept(path)
---

<Base
  title={`${title} | Message to PDF`}
  description={description}
  jsonLd={[
    guidePage({ path, headline: h1, description }),
    breadcrumbs(path, crumb),
    faqPage(faqs)
  ]}
>
  <main class="px-6 py-14 md:px-10">
    <div class="mx-auto w-full max-w-[46rem]">
      <nav aria-label="Breadcrumb" class="text-[#f5f3ef]/65 text-sm">
        <a class="transition-colors hover:text-[#cba980]" href="/">Message to PDF</a>
        <span aria-hidden="true" class="px-2 text-[#93735a]">/</span>
        <span aria-current="page">{crumb}</span>
      </nav>

      <h1 class="rise mt-6 font-[680] text-[clamp(1.9rem,4vw,2.5rem)] leading-[1.12] tracking-[-0.03em]">
        {h1}
      </h1>

      <div class={prose}>
        <slot />
      </div>

      <section class="mt-16 border-[#93735a]/25 border-t pt-10">
        <h2 class="font-[640] text-[clamp(1.3rem,2.4vw,1.6rem)] tracking-[-0.02em]">
          Questions people ask
        </h2>
        <div class="mt-6 divide-y divide-[#93735a]/25 border-[#93735a]/25 border-t">
          {
            faqs.map((item) => (
              <details class="group">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 font-[560] text-[#f5f3ef] transition-colors hover:text-[#cba980]">
                  {item.q}
                  <span
                    aria-hidden="true"
                    class="shrink-0 text-[#cba980] text-xl transition-transform group-open:rotate-45 motion-reduce:transform-none"
                  >
                    +
                  </span>
                </summary>
                <p class="pb-5 text-[#f5f3ef]/70 text-[0.96rem] leading-[1.6]">{item.a}</p>
              </details>
            ))
          }
        </div>
      </section>

      <section class="mt-14 rounded-2xl border border-[#93735a]/30 bg-[#2d2d2b] p-8">
        <h2 class="font-[660] text-[clamp(1.3rem,2.4vw,1.6rem)] tracking-[-0.02em]">$29, once.</h2>
        <p class="mt-3 max-w-[52ch] text-[#f5f3ef]/70">
          One payment, no subscription and no account. Runs on macOS 11 and later, Apple Silicon and
          Intel. If it is not for you, email us within 14 days and we will refund it.
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a
            class="whitespace-nowrap rounded-full bg-[#cba980] px-6 py-3 font-semibold text-[#23231f] transition-opacity hover:opacity-90 active:translate-y-px"
            href="/pricing"
          >
            Get it for $29
          </a>
          <a
            class="whitespace-nowrap rounded-full border border-[#93735a]/50 px-6 py-3 font-[560] text-[#f5f3ef] transition-colors hover:border-[#cba980]"
            href="/faq"
          >
            Read the FAQ
          </a>
        </div>
      </section>

      <section class="mt-14">
        <h2 class="font-[620] text-[#f5f3ef]/80 text-sm uppercase tracking-[0.08em]">Read next</h2>
        <div class="mt-5 space-y-5">
          {
            related.map((guide) => (
              <a class="group block border-[#93735a]/45 border-t pt-4" href={guide.path}>
                <h3 class="font-[620] text-[#cba980] text-[1.02rem] transition-colors group-hover:text-[#f5f3ef]">
                  {guide.title}
                </h3>
                <p class="mt-1.5 text-[#f5f3ef]/65 text-[0.95rem] leading-[1.55]">{guide.blurb}</p>
              </a>
            ))
          }
        </div>
      </section>
    </div>
  </main>
</Base>
