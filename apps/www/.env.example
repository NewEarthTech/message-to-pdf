# Paddle config for the pricing page and checkout. Copy this to `.env` (git
# ignored) for local dev. CI injects these in the deploy workflow.
#
# Astro only exposes variables prefixed PUBLIC_ to the browser, which is what
# the checkout needs. Nothing is silently defaulted: astro.config.mjs fails the
# build if the env/token pair is missing or mismatched, so you never run or ship
# against the wrong Paddle account.

# "sandbox" or "production". Local dev defaults to sandbox: test cards only,
# no real charges.
PUBLIC_PADDLE_ENV=sandbox

# Client-side token (public-safe: Paddle designs it to ship in frontend JS).
# MUST match the env, sandbox tokens are prefixed `test_`, live tokens `live_`.
# From Paddle > Developer tools > Authentication.
PUBLIC_PADDLE_CLIENT_TOKEN=test_xxxxxxxxxxxxxxxxxxxxxxxxxx

# The entitlement-gated download endpoint. /success links here with ?_ptxn=<txn>;
# that endpoint verifies the Paddle transaction and redirects to a short-lived
# signed CloudFront URL. Unset renders a "not wired yet" notice instead of a
# broken link.
PUBLIC_DOWNLOAD_ENDPOINT=https://downloads.newearth.llc/
